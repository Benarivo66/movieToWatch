{
    "swagger": "2.0",
    "info": {
      "title": "Users & Movies API",
      "description": "API documentation for managing users and movies",
      "version": "1.0.0"
    },
    "basePath": "/",
    "schemes": ["http", "https"],
    "securityDefinitions": {
      "CookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Cookie",
        "description": "Session authentication using the 'connect.sid' cookie. Obtain it from your browser after logging in via Google."
      }
    },
    "security": [
      {
        "CookieAuth": []
      }
    ],
    "paths": {
      "/users": {
        "post": {
          "description": "Create a new user",
          "parameters": [
            {
              "name": "body",
              "in": "body",
              "required": true,
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string", "example": "John" },
                  "lastName": { "type": "string", "example": "Doe" },
                  "dob": { "type": "string", "example": "1990-05-15" },
                  "country": { "type": "string", "example": "USA" },
                  "email": { "type": "string", "example": "johndoe@example.com" },
                  "sex": { "type": "string", "enum": ["Male", "Female"], "example": "Male" },
                  "phone": { "type": "string", "example": "1234567890" },
                  "watchlists": { "type": "array", "items": {"type": "string" }, "example": ["60c72b2f9b1d8e001c8d4567"]}
                }
              }
            }
          ],
          "responses": {
            "201": { "description": "User created successfully" },
            "400": { "description": "Bad Request" },
            "500": { "description": "Internal Server Error" }
          }
        },
        "get": {
          "description": "Retrieve all users",
          "security": [{ "CookieAuth": [] }],
          "responses": {
            "200": { "description": "OK" },
            "401": { "description": "Unauthorized - Login required" },
            "500": { "description": "Internal Server Error" }
          }
        }
      },
      "/users/{id}": {
        "get": {
          "description": "Retrieve a user by ID",
          "security": [{ "CookieAuth": [] }],
          "parameters": [
            { "name": "id", "in": "path", "required": true, "type": "string" }
          ],
          "responses": {
            "200": { "description": "OK" },
            "401": { "description": "Unauthorized - Login required" },
            "404": { "description": "Not Found" },
            "500": { "description": "Internal Server Error" }
          }
        },
        "put": {
        "description": "Update a user by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "type": "string" },
                "lastName": { "type": "string" },
                "email": { "type": "string" },
                "phone": { "type": "string" },
                "watchlists": { "type": "array", "items": {"type": "string" }, "example":"60c72b2f9b1d8e001c8d4567" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "User updated successfully" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
  "delete": {
    "description": "Delete a user by ID",
    "parameters": [
      { "name": "id", "in": "path", "required": true, "type": "string" }
    ],
    "responses": {
      "204": { "description": "User deleted successfully" },
      "404": { "description": "User Not Found" },
      "500": { "description": "Internal Server Error" }
    }
  }
      },
      "/movies": {
        "post": {
          "description": "Create a new movie",
          "parameters": [
            {
              "name": "body",
              "in": "body",
              "required": true,
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "example": "Inception" },
                  "genre": { "type": "string", "example": "Sci-Fi" },
                  "description": { "type": "string", "example": "A mind-bending thriller." },
                  "status": { "type": "string", "example": "Available" },
                  "releaseYear": { "type": "integer", "example": 2010 },
                  "duration": { "type": "integer", "example": 148 }
                }
              }
            }
          ],
          "responses": {
            "201": { "description": "Movie created successfully" },
            "400": { "description": "Bad Request" },
            "500": { "description": "Internal Server Error" }
          }
        },
        "get": {
          "description": "Retrieve all movies",
          "security": [{ "CookieAuth": [] }],
          "responses": {
            "200": { "description": "OK" },
            "401": { "description": "Unauthorized - Login required" },
            "500": { "description": "Internal Server Error" }
          }
        }
      },
      "/movies/{id}": {
      "get": {
        "description": "Retrieve a movie by ID",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
      "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized - Login required" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "description": "Update a movie by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "genre": { "type": "string" },
                "description": { "type": "string" },
                "status": { "type": "string" },
                "releaseYear": { "type": "integer" },
                "duration": { "type": "integer" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Movie updated successfully" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "description": "Delete a movie by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/reviews": {
        "post": {
          "description": "Create a new review",
          "parameters": [
            {
              "name": "body",
              "in": "body",
              "required": true,
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string", "example": "67ed63c31d3a31dc75ce4255" },
                  "movieId": { "type": "string", "example": "67ed63c31d3a31dc75ce4256" },
                  "rating": { "type": "integer", "example": 4 },
                  "comment": { "type": "string", "example": "The movie is good" }
                }
              }
            }
          ],
          "responses": {
            "201": { "description": "Review created successfully" },
            "400": { "description": "Bad Request" },
            "500": { "description": "Internal Server Error" }
          }
        },
        "get": {
          "description": "Retrieve all reviews",
          "responses": {
            "200": { "description": "OK" },
            "500": { "description": "Internal Server Error" }
          }
        }
      },
      "/reviews/{id}": {
      "get": {
        "description": "Retrieve a review by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
      "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "description": "Update a review by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "rating": { "type": "integer" },
                "comment": { "type": "string" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Review updated successfully" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "description": "Delete a review by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/watchlists": {
        "post": {
          "description": "Create a new watchlist",
          "parameters": [
            {
              "name": "body",
              "in": "body",
              "required": true,
              "schema": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string", "example": "67ed63c31d3a31dc75ce4257" },
                  "title": { "type": "string", "example": "My funny watchlist" },
                  "movies": { "type": "array", "items": {"type": "string"}, "example": ["60c72b2f9b1d8e001c8d4567"] },
                  "sharedWith": { "type": "array", "items": {"type": "string"}, "example": ["60c72b2f9b1d8e001c8d4567"] }
                }
              }
            }
          ],
          "responses": {
            "201": { "description": "Watchlist created successfully" },
            "400": { "description": "Bad Request" },
            "500": { "description": "Internal Server Error" }
          }
        },
        "get": {
          "description": "Retrieve all watchlists",
          "responses": {
            "200": { "description": "OK" },
            "500": { "description": "Internal Server Error" }
          }
        }
      },
      "/watchlists/{id}": {
      "get": {
        "description": "Retrieve a watchlist by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
      "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "description": "Update a watchlist by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "movies": { "type": "array", "items": {"type": "string"}, "example": ["60c72b2f9b1d8e001c8d4567"] },
                "sharedWith": { "type": "array", "items": {"type": "string"}, "example": ["60c72b2f9b1d8e001c8d4567"] }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Watchlist updated successfully" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "description": "Delete a watchlist by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  }
}  
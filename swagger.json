{
    "swagger": "2.0",
    "info": {
      "title": "Users & Movies API",
      "description": "API documentation for managing users and movies",
      "version": "1.0.0"
    },
    "basePath": "/",
    "schemes": ["https", "http"],
    "securityDefinitions": {
      "CookieAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Cookie",
        "description": "Session authentication using the 'connect.sid' cookie. Obtain it from your browser after logging in via Google."
      }
    },
    "security": [
      {
        "CookieAuth": []
      }
    ],
    "paths": {
      "/users": {
        "post": {
          "description": "Create a new user",
          "parameters": [
            {
              "name": "body",
              "in": "body",
              "required": true,
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string", "example": "John" },
                  "lastName": { "type": "string", "example": "Doe" },
                  "dob": { "type": "string", "example": "1990-05-15" },
                  "country": { "type": "string", "example": "USA" },
                  "email": { "type": "string", "example": "johndoe@example.com" },
                  "sex": { "type": "string", "enum": ["Male", "Female"], "example": "Male" },
                  "phone": { "type": "string", "example": "1234567890" }
                }
              }
            }
          ],
          "responses": {
            "201": { "description": "User created successfully" },
            "400": { "description": "Bad Request" },
            "500": { "description": "Internal Server Error" }
          }
        },
        "get": {
          "description": "Retrieve all users",
          "security": [{ "CookieAuth": [] }],
          "responses": {
            "200": { "description": "OK" },
            "401": { "description": "Unauthorized - Login required" },
            "500": { "description": "Internal Server Error" }
          }
        }
      },
      "/users/{id}": {
        "get": {
          "description": "Retrieve a user by ID",
          "security": [{ "CookieAuth": [] }],
          "parameters": [
            { "name": "id", "in": "path", "required": true, "type": "string" }
          ],
          "responses": {
            "200": { "description": "OK" },
            "401": { "description": "Unauthorized - Login required" },
            "404": { "description": "Not Found" },
            "500": { "description": "Internal Server Error" }
          }
        }
      },
      "/movies": {
        "post": {
          "description": "Create a new movie",
          "parameters": [
            {
              "name": "body",
              "in": "body",
              "required": true,
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "example": "Inception" },
                  "genre": { "type": "string", "example": "Sci-Fi" },
                  "description": { "type": "string", "example": "A mind-bending thriller." },
                  "status": { "type": "string", "example": "Available" },
                  "releaseYear": { "type": "integer", "example": 2010 },
                  "duration": { "type": "integer", "example": 148 }
                }
              }
            }
          ],
          "responses": {
            "201": { "description": "Movie created successfully" },
            "400": { "description": "Bad Request" },
            "500": { "description": "Internal Server Error" }
          }
        },
        "get": {
          "description": "Retrieve all movies",
          "security": [{ "CookieAuth": [] }],
          "responses": {
            "200": { "description": "OK" },
            "401": { "description": "Unauthorized - Login required" },
            "500": { "description": "Internal Server Error" }
          }
        }
      },
      "/movies/{id}": {
      "get": {
        "description": "Retrieve a movie by ID",
        "security": [{ "CookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
      "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthorized - Login required" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "description": "Update a movie by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "genre": { "type": "string" },
                "description": { "type": "string" },
                "status": { "type": "string" },
                "releaseYear": { "type": "integer" },
                "duration": { "type": "integer" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Movie updated successfully" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "description": "Delete a movie by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  }
}  